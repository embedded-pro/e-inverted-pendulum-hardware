	)
	(text "+5V -> 33 Ohm -> MLT-8530 (16 Ohm):\npeak ~96 mA (rated 95 mA max).\n470 Ohm base, 1N4148WS across the coil\n(MLT-8530 p.3).  R807 holds Q801 off\nwhile the MCU is in reset.  2.7 kHz."
		(exclude_from_sim no)
		(at 330.2 50.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "06c6d090-5e6d-5e0d-8b87-b3f9ea37957a")
	)
