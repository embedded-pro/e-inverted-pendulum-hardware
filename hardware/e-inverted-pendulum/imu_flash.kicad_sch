	(text "IMU: MPU-6500 on SPI2 (D-004)"
		(exclude_from_sim no)
		(at 16.51 24.13 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "4a272499-98e6-5193-bfe4-2bb5df9564ea")
	)
	(text "SPI2: PB13 SCK, PB15 MOSI, PB14 MISO, PB12 nCS (GPIO); INT to PC6 (EXTI6, data ready).\nDecoupling per PS-MPU-6500A-01 Table 11: C1 100 nF REGOUT, C2 100 nF VDD, C3 10 nF VDDIO.\nR701 holds nCS high until the MCU drives it: SDO stays high-Z and the part stays in SPI mode.\nFSYNC unused, tied to GND (Table 10); AUX_DA / AUX_CL unconnected.\nMount rigidly beside the MCU, ~90 mm above the axle, axes x forward / y left / z up (HW-SNS-002, D-029)."
		(exclude_from_sim no)
		(at 20.32 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6916fb81-1b17-55fa-9a00-e53dd6bc3e59")
	)
	(text "VDDIO"
		(exclude_from_sim no)
		(at 43.18 55.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a63c4189-7e87-5d83-8f94-fafa765b9bda")
	)
	(text "SPI flash: W25Q16JV on SPI1 (D-005)"
		(exclude_from_sim no)
		(at 207.01 24.13 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "bc5a3383-cf08-5af5-a128-6b11d79e4add")
	)
	(text "W25Q16JVSSIQ, 16 Mbit: SPI1 shared with the DRV8711 (SCK through R301 on the MCU sheet), /CS on PA15.\nR702 keeps /CS at VCC through power-up (s10.3).  /WP and /HOLD pulled up so IO2 / IO3 are defined;\nthe IQ variant ships with QE = 1."
		(exclude_from_sim no)
		(at 210.82 137.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "eb6693a1-f736-5fb2-89da-f0f45688b624")
	)
	(text "REGOUT"
		(exclude_from_sim no)
		(at 81.28 55.88 0)
