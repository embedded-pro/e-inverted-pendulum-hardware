	(text "One 100 nF per supply pin, at the pin, each with its own via; 4.7 uF bulk on VDD.  VDDRF 100 nF + 100 pF at pin 33.\nVDDA and VREF+ through FB301: 10 nF + 1 uF on VDDA, 100 nF + 1 uF on VREF+ (mcu-circuit-design s2).\nVDDUSB to VDD: USB unused (DS11929 s3.7).  VBAT to VDD: no backup domain battery."
		(exclude_from_sim no)
		(at 20.32 66.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "132fb68e-2daf-5116-936b-78100471fe62")
	)
