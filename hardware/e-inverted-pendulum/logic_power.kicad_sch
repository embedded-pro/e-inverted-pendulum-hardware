		)
		(uuid "3608e0a4-46ff-528f-982a-94681e6009a6")
	)
	(text "TLV75533P: 3.3 V, 500 mA, EN tied to IN.\nC_IN 1 uF, C_OUT 2.2 uF (>= 0.47 uF effective,\nSBVS320A s6.3, s8.1.1).\n0.20 W at 115 mA -> +45 C (R_thJA 231 C/W)."
		(exclude_from_sim no)
		(at 243.84 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
