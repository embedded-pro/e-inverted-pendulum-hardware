	(text "Bridge B: right MG310 (MOT_R_P / MOT_R_N)"
		(exclude_from_sim no)
		(at 207.01 138.43 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "0c2be8fe-f904-5ba9-bb9a-4d0c1edfcbf1")
	)
	(text "nFAULT, nSTALL: open drain, 10k to +3V3.  SDATO is open drain on the shared MISO: 2.2k (tau ~66 ns, SPI <= 4 MHz).\nnSLEEP: 10k pull-down, no internal pull, so the driver sleeps while the MCU is in reset (SLVSC40 p.3).\nPWMMODE 1: TIM1 drives AIN1/AIN2/BIN1/BIN2 directly (indexer bypassed).  Firmware: IDRIVE 00,\nTBLANK >= 1.2 us, SCLK <= 4 MHz, SCS active high.  Trip 2.0 A: ISGAIN 20, TORQUE 186 (D-027, S0)."
		(exclude_from_sim no)
		(at 20.32 210.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "56e30a14-db9d-5018-b112-34aaeb58a3fb")
	)
	(text "A1 / A2: CSD88537ND, FET1 high side, FET2 low side; 0 Ohm gate R at each FET (edge-rate trim).\nSS34 from GND to each phase node: freewheel at -0.36 V, not the -0.73 V body diode (phase pins abs max -0.6 V, S2).\nR509 50 mOhm: the motor current flows straight through it; Kelvin taps from its inner pad edges (NT501 at the GND pad).\n0 Ohm filter legs, C501 DNP: fit 27-33 Ohm + 1 nF if noisy (SLVSC40 Fig. 6).  C502 + C503 at the HS drains: hot loop over L2 GND."
		(exclude_from_sim no)
		(at 210.82 114.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "671d0286-c797-5344-a9d4-0b7f1a036730")
	)
	(text "VM (pin 4): C507 220 uF bulk (>= 100 uF, 600 mA ripple) + C508 10 nF at the pin.  VCP: C509 1 uF to VM.\nCP1-CP2: C510 100 nF, >= VM + 12 V.  V5 100 nF, VINT 1 uF, BEMF 1 nF C0G (SLVSC40 p.3-4)."
		(exclude_from_sim no)
		(at 20.32 67.31 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7e1c095e-3e7f-580d-976a-cc8e7056cbe6")
	)
	(text "Bridge A: left MG310 (MOT_L_P / MOT_L_N)"
		(exclude_from_sim no)
		(at 207.01 24.13 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "8eeb827e-f16b-5e06-9607-359d3ecde661")
	)
	(text "DRV8711 gate driver (PWMMODE 1, D-002)"
		(exclude_from_sim no)
		(at 16.51 24.13 0)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "a777e313-f331-56ca-a637-aec807767598")
	)
	(text "B1 / B2: CSD88537ND, FET1 high side, FET2 low side; 0 Ohm gate R at each FET (edge-rate trim).\nSS34 from GND to each phase node: freewheel at -0.36 V, not the -0.73 V body diode (phase pins abs max -0.6 V, S2).\nR512 50 mOhm: the motor current flows straight through it; Kelvin taps from its inner pad edges (NT502 at the GND pad).\n0 Ohm filter legs, C504 DNP: fit 27-33 Ohm + 1 nF if noisy (SLVSC40 Fig. 6).  C505 + C506 at the HS drains: hot loop over L2 GND."
		(exclude_from_sim no)
		(at 210.82 228.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "def33a5c-1a17-5938-a8c0-eecef7d45bcc")
	)
