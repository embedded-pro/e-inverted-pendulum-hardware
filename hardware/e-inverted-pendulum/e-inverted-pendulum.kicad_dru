(version 1)

# BEGIN pcb_rules managed block (jlcpcb, 4+ layers). Re-run pcb_rules.py apply to change;
# rules you add below this block override it.
(rule "fab: plated pad annular ring"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint annular_width (min 0.15mm)))
(rule "fab: pad hole to pad hole (different nets)"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && (A.NetName != B.NetName || A.NetName == '')")
  (constraint hole_to_hole (min 0.45mm)))
(rule "fab: plated pad hole to copper"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint hole_clearance (min 0.28mm)))
(rule "fab: NPTH minimum drill"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
  (constraint hole_size (min 0.5mm)))
(rule "quality: 45-degree corners only (no 90-degree or acute corners, no mid-track branches)"
  (constraint track_angle (min 135)))
# END pcb_rules managed block

# Project rules (scripts/pcb/board.py). They follow the pcb_rules block, so they win where both match.

(rule "RF1: MB1355's 0.265 mm fan-out from pin 31 to FL401 between the 0.4 mm-pitch pins (D-037, docs/rf.md)"
  (condition "A.NetName == 'RF1'")
  (constraint clearance (min 0.104mm)))

(rule "MB1355 RF corner: ST's own 0.1 mm clearance inside the copied group (above JLCPCB's 0.09 mm, D-037)"
  (condition "A.memberOfGroup('MB1355 RF corner') && B.memberOfGroup('MB1355 RF corner')")
  (constraint clearance (min 0.1mm)))

(rule "MB1355 RF corner: ST's own placement (shared 0R switch pad, crystal and clips packed tight, D-037)"
  (severity ignore)
  (condition "A.memberOfGroup('MB1355 RF corner') && B.memberOfGroup('MB1355 RF corner')")
  (constraint courtyard_clearance (min 0mm)))

(rule "MB1355 RF corner: ST's routing keeps its arcs and corners (D-037)"
  (condition "A.memberOfGroup('MB1355 RF corner')")
  (constraint track_angle (min 0)))

(rule "MB1163 NFC corner: ST's routing keeps its corners and its GND branch (D-039)"
  (condition "A.memberOfGroup('MB1163 NFC corner')")
  (constraint track_angle (min 0)))

(rule "BOOST-DRV8711 drive: TI's own 0.178 mm clearance inside the copied group (above JLCPCB's 0.09 mm, D-040)"
  (condition "A.memberOfGroup('BOOST-DRV8711 drive') && B.memberOfGroup('BOOST-DRV8711 drive')")
  (constraint clearance (min 0.178mm)))

(rule "BOOST-DRV8711 drive: TI's routing keeps its corners (D-040)"
  (condition "A.memberOfGroup('BOOST-DRV8711 drive')")
  (constraint track_angle (min 0)))

(rule "Antenna tab: only the antenna feed may cross it (MB1355 ground-free tab, D-037)"
  (condition "A.Type == 'Track' && A.intersectsArea('ANTENNA_TAB') && A.NetName != '/4 2.4 GHz RF path and antenna/RF_ANT'")
  (constraint disallow track))

(rule "Battery on the back: no through-hole pins under it (D-025)"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.insideArea('BATTERY_BACK')")
  (constraint disallow pad))

(rule "Bracket strip: no parts except the bracket holes (D-026)"
  (condition "A.Type == 'Footprint' && A.insideArea('BRACKET_STRIP') && A.Reference != 'MB*'")
  (constraint disallow footprint))

(rule "NPTH to copper: screw threads touch the hole wall; washers and brackets are kept off by the footprint keep-out"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
  (constraint hole_clearance (min 0.5mm)))
