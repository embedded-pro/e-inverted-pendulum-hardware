				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "c4e76c3a-804a-5f30-a8a8-94486a4e9e7d")
	)
	(text "ENC_VCC: 5V0 through R601 (default, D-016)\nor 3V3 through R602 (DNP).\nF601 100 mA PTC: a shorted encoder cable\ncan't pull the rail down."
		(exclude_from_sim no)
		(at 127 43.18 0)
